# =====================================================================
# НАСТРОЙКИ ПОДКЛЮЧЕНИЯ И РЕЖИМА ТОРГОВЛИ BYBIT
# =====================================================================
# Режим: DEMO (демо-счет Bybit) или LIVE (реальный счет Bybit)
TRADING_MODE=DEMO

# Ключи для ДЕМО-счета (Bybit Demo Trading)
DEMO_API_KEY=your_demo_key
DEMO_API_SECRET=your_demo_secret

# Ключи для БОЕВОГО счета (Bybit Live Mainnet)
LIVE_API_KEY=your_live_key
LIVE_API_SECRET=your_live_secret

# =====================================================================
# НАСТРОЙКИ ЛОКАЛЬНОГО ВЕБ-ДАШБОРДА (TERMUX / LOCAL NETWORK)
# =====================================================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
# Авторизация дашборда (оставьте пустыми, если пароль не требуется)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_password

# =====================================================================
# УПРАВЛЕНИЕ РИСКАМИ И КАПИТАЛОМ
# =====================================================================
USE_RISK_BASED_SIZING=true       # true: риск от стопа, false: фиксированная маржа
RISK_PER_TRADE_PCT=0.015         # 1.5% риска от капитала на сделку
MAX_SLIPPAGE_PCT=0.015           # 1.5% макс. проскальзывание цены
ACTIVE_STRATEGY=SUPERTREND_PRO

